{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/claude.ts": { "maxDuration": 60 }
  },
  "routes": [
    {
      "src": "/api/claude/messages",
      "dest": "/api/claude"
    },
    {
      "src": "/api/bls/([^/]+)",
      "dest": "/api/bls?seriesId=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
