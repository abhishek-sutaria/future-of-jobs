{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/claude.ts": {
      "maxDuration": 120
    }
  },
  "routes": [
    {
      "src": "/api/claude/messages",
      "dest": "/api/claude"
    },
    {
      "src": "/api/bls/([^/]+)",
      "dest": "/api/bls?seriesId=$1"
    },
    {
      "src": "/manifest\\.webmanifest",
      "headers": {
        "Content-Type": "application/manifest+json; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/icons/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(icons/.*|manifest\\.webmanifest)",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
